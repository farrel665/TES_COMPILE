<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical">
        <TextView android:id="@+id/btn_back_macro_settings" android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textColor="#FFFFFF" android:textSize="30sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Macro Settings" android:textColor="#F5F5F5" android:textSize="21sp" android:fontFamily="@font/gf_bold"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Macro Manager • Trigger" android:textColor="#92959A" android:textSize="12sp" android:fontFamily="@font/gf_light"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Trigger Size" android:textColor="#D6D6D6" android:textSize="15sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical"><com.ancore.GamingSeekBar android:id="@+id/seek_trigger_size" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1"/><TextView android:id="@+id/val_trigger_size" android:layout_width="55dp" android:layout_height="wrap_content" android:gravity="end" android:text="100dp" android:textColor="#FFFFFF" android:textSize="13sp"/></LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Trigger Opacity" android:textColor="#D6D6D6" android:textSize="15sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical"><com.ancore.GamingSeekBar android:id="@+id/seek_trigger_opacity" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1"/><TextView android:id="@+id/val_trigger_opacity" android:layout_width="55dp" android:layout_height="wrap_content" android:gravity="end" android:text="90%" android:textColor="#FFFFFF" android:textSize="13sp"/></LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Macro Type" android:textColor="#F0F0F0" android:textSize="17sp" android:fontFamily="@font/gf_medium"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="5dp" android:orientation="horizontal">
        <TextView android:id="@+id/macro_type_tap" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Tap
One tap per press" android:textColor="#FFFFFF" android:textSize="12sp" android:background="@drawable/bg_btn_dark"/>
        <TextView android:id="@+id/macro_type_hold" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="7dp" android:gravity="center" android:text="Hold
Repeat while pressed" android:textColor="#FFFFFF" android:textSize="12sp" android:background="@drawable/bg_btn_red"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Trigger Behavior" android:textColor="#F0F0F0" android:textSize="17sp" android:fontFamily="@font/gf_medium"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="5dp" android:background="#161A1A" android:padding="10dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hold to repeat" android:textColor="#FFFFFF" android:textSize="13sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Macro starts while pressed and stops immediately on release." android:textColor="#777777" android:textSize="10sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="7dp" android:background="#161A1A" android:padding="10dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Move Trigger" android:textColor="#FFFFFF" android:textSize="13sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trigger can be moved only while Macro Manager is open." android:textColor="#777777" android:textSize="10sp"/>
    </LinearLayout>
</LinearLayout></ScrollView>

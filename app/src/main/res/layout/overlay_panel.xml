<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/bubble"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_ancore"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:elevation="8dp" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="12dp"
        android:elevation="12dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="ancore injection"
                android:textColor="#EAEBEF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_hide"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="–"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/bg_btn_dark" />

            <TextView
                android:id="@+id/btn_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:background="@drawable/bg_btn_dark" />
        </LinearLayout>

        <!-- Area -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sensitivity Area"
            android:textColor="#B0B3BA"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/area_left"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Left"
                android:textColor="#B0B3BA"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_dark" />

            <TextView
                android:id="@+id/area_all"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="All"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_red" />

            <TextView
                android:id="@+id/area_right"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Right"
                android:textColor="#B0B3BA"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_dark" />
        </LinearLayout>

        <!-- Sens X: [-] seek [+]  value -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensitivity X"
                android:textColor="#B0B3BA"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/val_sens_x"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="2.00x"
                android:textColor="#F23A48"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.ancore.GamingSeekBar
            android:id="@+id/seek_sens_x"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp" />

        <!-- Sens Y -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensitivity Y"
                android:textColor="#B0B3BA"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/val_sens_y"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="2.00x"
                android:textColor="#F23A48"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.ancore.GamingSeekBar
            android:id="@+id/seek_sens_y"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp" />

        <!-- TactiX row compact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TactiX"
                android:textColor="#EAEBEF"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/check_tactix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#E61F33"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- START / STOP -->
        <TextView
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="START"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/bg_btn_red" />

        <TextView
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="STOP"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/bg_btn_dark"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Standing"
            android:textColor="#8A8E96"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_overlay"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="310dp"
        android:layout_height="425dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_panel">

        <ScrollView
            android:id="@+id/panel_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <LinearLayout
            android:id="@+id/drag_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Magic Manager"
                android:textColor="#F5F5F5"
                android:textSize="28sp"
                android:fontFamily="@font/gf_bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Free Fire • com.dts.freefireth"
                android:textColor="#A6A6A6"
                android:textSize="14sp"
                android:fontFamily="@font/gf_light" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Magic Touch"
            android:textColor="#F0F0F0"
            android:textSize="21sp"
            android:fontFamily="@font/gf_medium" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Intercept and remap touchscreen input via privileged injector"
                android:textColor="#777777"
                android:textSize="12sp"
                android:fontFamily="@font/gf_light" />
            <com.ancore.GamingSwitch
                android:id="@+id/switch_active"
                android:layout_width="66dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Macro Auto Click"
            android:textColor="#D6D6D6"
            android:textSize="16sp"
            android:fontFamily="@font/gf_medium" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/macro_hold_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_btn_dark"
                android:text="HOLD TO CLICK"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/gf_bold" />
            <TextView
                android:id="@+id/val_macro_interval"
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:layout_marginStart="8dp"
                android:text="100ms"
                android:textColor="#E51010"
                android:textSize="13sp"
                android:fontFamily="@font/gf_medium" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Tahan tombol untuk menjalankan • lepas untuk berhenti • titik tap default di tengah layar"
            android:textColor="#777777"
            android:textSize="10sp"
            android:fontFamily="@font/gf_light" />
        <com.ancore.GamingSeekBar
            android:id="@+id/seek_macro_interval"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sensitivity Area"
            android:textColor="#D6D6D6"
            android:textSize="16sp"
            android:fontFamily="@font/gf_medium" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <com.ancore.HexagonLinearLayout
                android:id="@+id/area_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:background="@android:color/transparent">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_area_left" />
                <TextView
                    android:id="@+id/area_left_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Left"
                    android:textColor="#B0B3BA"
                    android:textSize="12sp"
                    android:fontFamily="@font/gf_medium" />
            </com.ancore.HexagonLinearLayout>
            <com.ancore.HexagonLinearLayout
                android:id="@+id/area_all"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:background="@android:color/transparent">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_area_all" />
                <TextView
                    android:id="@+id/area_all_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/gf_medium" />
            </com.ancore.HexagonLinearLayout>
            <com.ancore.HexagonLinearLayout
                android:id="@+id/area_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="5dp"
                android:background="@android:color/transparent">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_area_right" />
                <TextView
                    android:id="@+id/area_right_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Right"
                    android:textColor="#B0B3BA"
                    android:textSize="12sp"
                    android:fontFamily="@font/gf_medium" />
            </com.ancore.HexagonLinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sensitivity X (Horizontal)"
            android:textColor="#D6D6D6"
            android:textSize="16sp"
            android:fontFamily="@font/gf_medium" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/val_sens_x"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="2.00×"
                android:textColor="#E51010"
                android:textSize="15sp"
                android:fontFamily="@font/gf_medium" />
            <com.ancore.GamingSeekBar
                android:id="@+id/seek_sens_x"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1" />
            <ImageView
                android:id="@+id/img_reset_x"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:src="@drawable/ic_reset"
                android:contentDescription="Reset X" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensitivity Y (Vertical)"
            android:textColor="#D6D6D6"
            android:textSize="16sp"
            android:fontFamily="@font/gf_medium" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/val_sens_y"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="2.00×"
                android:textColor="#E51010"
                android:textSize="15sp"
                android:fontFamily="@font/gf_medium" />
            <com.ancore.GamingSeekBar
                android:id="@+id/seek_sens_y"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1" />
            <ImageView
                android:id="@+id/img_reset_y"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:src="@drawable/ic_reset"
                android:contentDescription="Reset Y" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="TactiX"
            android:textColor="#F0F0F0"
            android:textSize="18sp"
            android:fontFamily="@font/gf_medium" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Steadier aim when still, no lag on flicks"
                android:textColor="#777777"
                android:textSize="11sp"
                android:fontFamily="@font/gf_light" />
            <com.ancore.OctagonCheckBox
                android:id="@+id/check_tactix"
                android:layout_width="29dp"
                android:layout_height="29dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Strength"
            android:textColor="#D6D6D6"
            android:textSize="16sp"
            android:fontFamily="@font/gf_medium" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.ancore.GamingSeekBar
                android:id="@+id/seek_strength"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/val_strength"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0%"
                android:textColor="#E51010"
                android:textSize="14sp"
                android:fontFamily="@font/gf_medium" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Responsiveness"
            android:textColor="#D6D6D6"
            android:textSize="16sp"
            android:fontFamily="@font/gf_medium" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.ancore.GamingSeekBar
                android:id="@+id/seek_responsiveness"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/val_responsiveness"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0%"
                android:textColor="#E51010"
                android:textSize="14sp"
                android:fontFamily="@font/gf_medium" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disengaged"
                android:textColor="#777777"
                android:textSize="11sp"
                android:fontFamily="@font/gf_light" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btn_hide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Hide"
                android:textColor="#888888"
                android:textSize="11sp"
                android:fontFamily="@font/gf_medium" />
            <TextView
                android:id="@+id/btn_close"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Close"
                android:textColor="#E51010"
                android:textSize="11sp"
                android:fontFamily="@font/gf_medium" />
        </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    <FrameLayout
        android:id="@+id/bubble"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:visibility="gone"
        android:background="@drawable/bg_bubble">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="M"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="@font/gf_bold" />
    </FrameLayout>
</FrameLayout>

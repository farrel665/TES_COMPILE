<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- ── Bubble (minimized) ────────────────────────────────── -->
    <ImageView
        android:id="@+id/bubble"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_rizxbyte"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:elevation="8dp" />

    <!-- ── Panel ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="14dp"
        android:elevation="12dp">

        <!-- ══ HEADER: Magic Manager ══════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Title block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Magic Manager"
                    android:textColor="#EAEBEF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free Fire · com.dts.freefireth"
                    android:textColor="#55585F"
                    android:textSize="9sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Hide button -->
            <TextView
                android:id="@+id/btn_hide"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="–"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="@drawable/bg_hexagon_dark" />

            <!-- Close button -->
            <TextView
                android:id="@+id/btn_close"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/bg_hexagon_dark" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="#1A1C24" />

        <!-- ══ MAGIC TOUCH ════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Text block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Magic Touch"
                    android:textColor="#EAEBEF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intercept and remap touchscreen input via privileged injector"
                    android:textColor="#55585F"
                    android:textSize="9sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Magic Touch toggle switch -->
            <Switch
                android:id="@+id/switch_magic_touch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:thumbTint="#E61F33"
                android:trackTint="#38000A"
                android:checked="false" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="#1A1C24" />

        <!-- ══ SENSITIVITY AREA ═══════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensitivity Area"
            android:textColor="#55585F"
            android:textSize="10sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/area_left"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Left"
                android:textColor="#B0B3BA"
                android:textSize="11sp"
                android:background="@drawable/bg_hexagon_dark" />

            <TextView
                android:id="@+id/area_all"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:text="All"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/bg_hexagon_red" />

            <TextView
                android:id="@+id/area_right"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Right"
                android:textColor="#B0B3BA"
                android:textSize="11sp"
                android:background="@drawable/bg_hexagon_dark" />
        </LinearLayout>

        <!-- ══ SENSITIVITY X ══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sensitivity X (Horizontal)"
                android:textColor="#55585F"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/val_sens_x"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.00x"
                android:textColor="#F23A48"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/btn_sens_x_minus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/bg_hexagon_dark" />

            <SeekBar
                android:id="@+id/seek_sens_x"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:max="900"
                android:progress="0"
                android:progressTint="#E61F33"
                android:thumbTint="#E61F33"
                android:progressBackgroundTint="#252530" />

            <TextView
                android:id="@+id/btn_sens_x_plus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/bg_hexagon_dark" />
        </LinearLayout>

        <!-- ══ SENSITIVITY Y ══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sensitivity Y (Vertical)"
                android:textColor="#55585F"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/val_sens_y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.00x"
                android:textColor="#F23A48"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/btn_sens_y_minus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/bg_hexagon_dark" />

            <SeekBar
                android:id="@+id/seek_sens_y"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:max="900"
                android:progress="0"
                android:progressTint="#E61F33"
                android:thumbTint="#E61F33"
                android:progressBackgroundTint="#252530" />

            <TextView
                android:id="@+id/btn_sens_y_plus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/bg_hexagon_dark" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:background="#1A1C24" />

        <!-- ══ TACTIX FOOTER ROW ══════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TactiX"
                android:textColor="#EAEBEF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/check_tactix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#E61F33"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Standing"
            android:textColor="#3E414A"
            android:textSize="9sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Magic Manager" android:textColor="#F5F5F5" android:textSize="22sp" android:fontFamily="@font/gf_bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Touch control center" android:textColor="#92959A" android:textSize="9sp" android:fontFamily="@font/gf_light"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="18dp" android:orientation="vertical">
        <com.ancore.HexagonLinearLayout
            android:id="@+id/btn_sensitivity_manager" android:layout_width="match_parent" android:layout_height="86dp"
            android:padding="14dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sensitivity Manager"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:fontFamily="@font/gf_bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="Sensitivity, TactiX and touch response" android:textColor="#8E9095" android:textSize="9sp" android:fontFamily="@font/gf_light"/>
            </LinearLayout>
            <TextView android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="›"
                android:textColor="#E51010" android:textSize="28sp" android:fontFamily="@font/gf_bold"/>
        </com.ancore.HexagonLinearLayout>

        <com.ancore.HexagonLinearLayout
            android:id="@+id/btn_macro_manager" android:layout_width="match_parent" android:layout_height="86dp"
            android:layout_marginTop="10dp" android:padding="14dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Macro"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:fontFamily="@font/gf_bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:text="Create and configure touch macros" android:textColor="#8E9095" android:textSize="9sp" android:fontFamily="@font/gf_light"/>
            </LinearLayout>
            <TextView android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="›"
                android:textColor="#E51010" android:textSize="28sp" android:fontFamily="@font/gf_bold"/>
        </com.ancore.HexagonLinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/status_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Ready" android:textColor="#777777" android:textSize="9sp" android:fontFamily="@font/gf_light"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/btn_back_macro"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="30sp"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Macro Manager"
                    android:textColor="#F5F5F5"
                    android:textSize="20sp"
                    android:fontFamily="@font/gf_bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trigger • Tap control"
                    android:textColor="#92959A"
                    android:textSize="9sp"
                    android:fontFamily="@font/gf_light"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:background="#161A1A"
            android:paddingLeft="10dp"
            android:paddingRight="8dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trigger"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/gf_medium"/>
                <TextView
                    android:id="@+id/trigger_pos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#777777"
                    android:textSize="9sp"
                    android:fontFamily="@font/gf_light"/>
            </LinearLayout>
            <com.ancore.GamingSwitch
                android:id="@+id/switch_trigger"
                android:layout_width="56dp"
                android:layout_height="30dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Interval Tap"
            android:textColor="#F0F0F0"
            android:textSize="14sp"
            android:fontFamily="@font/gf_medium"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical">
            <com.ancore.GamingSeekBar
                android:id="@+id/seek_macro_interval"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/val_macro_interval"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="70 ms"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/gf_bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Duration Tap"
            android:textColor="#F0F0F0"
            android:textSize="14sp"
            android:fontFamily="@font/gf_medium"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical">
            <com.ancore.GamingSeekBar
                android:id="@+id/seek_macro_duration"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/val_macro_duration"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="70 ms"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/gf_bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Trigger Size"
            android:textColor="#F0F0F0"
            android:textSize="14sp"
            android:fontFamily="@font/gf_medium"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical">
            <com.ancore.GamingSeekBar
                android:id="@+id/seek_trigger_size"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/val_trigger_size"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="100dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Trigger Opacity"
            android:textColor="#F0F0F0"
            android:textSize="14sp"
            android:fontFamily="@font/gf_medium"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical">
            <com.ancore.GamingSeekBar
                android:id="@+id/seek_trigger_opacity"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/val_trigger_opacity"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="90%"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Klik Trigger = satu tap. Tahan = repeat sesuai interval."
            android:textColor="#20E6AA"
            android:textSize="10sp"
            android:fontFamily="@font/gf_light"/>
    </LinearLayout>
</ScrollView>

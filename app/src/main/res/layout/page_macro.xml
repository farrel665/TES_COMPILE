<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/btn_macro_settings" android:layout_width="34dp" android:layout_height="34dp" android:padding="5dp" android:src="@drawable/ic_settings" android:contentDescription="Macro settings"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="6dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Macro Manager" android:textColor="#F5F5F5" android:textSize="20sp" android:fontFamily="@font/gf_bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Macro Manager" android:textColor="#777777" android:textSize="10sp" android:fontFamily="@font/gf_light"/>
        </LinearLayout>
        <TextView android:id="@+id/btn_back_macro" android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textColor="#FFFFFF" android:textSize="30sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="5dp" android:background="#111718" android:padding="2dp">
        <TextView android:id="@+id/tab_tap" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Tap" android:textColor="#999999" android:textSize="11sp"/>
        <TextView android:id="@+id/tab_repeat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Repeat Tap" android:textColor="#FFFFFF" android:textSize="11sp" android:background="@drawable/bg_btn_red"/>
        <TextView android:id="@+id/tab_double" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Double Tap" android:textColor="#999999" android:textSize="11sp"/>
        <TextView android:id="@+id/tab_release" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Release Tap" android:textColor="#999999" android:textSize="11sp"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Macro Target" android:textColor="#F0F0F0" android:textSize="17sp" android:fontFamily="@font/gf_medium"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tekan Trigger untuk menjalankan macro. Buka menu ini untuk memindahkan posisi Trigger." android:textColor="#777777" android:textSize="10sp" android:fontFamily="@font/gf_light"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:background="#161A1A" android:paddingLeft="10dp" android:paddingRight="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trigger" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="@font/gf_medium"/>
            <TextView android:id="@+id/trigger_pos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OFF" android:textColor="#777777" android:textSize="9sp" android:fontFamily="@font/gf_light"/>
        </LinearLayout>
        <com.ancore.GamingSwitch android:id="@+id/switch_trigger" android:layout_width="56dp" android:layout_height="30dp"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Interval Tap:" android:textColor="#F0F0F0" android:textSize="15sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical">
        <com.ancore.GamingSeekBar android:id="@+id/seek_macro_interval" android:layout_width="0dp" android:layout_height="31dp" android:layout_weight="1"/>
        <TextView android:id="@+id/val_macro_interval" android:layout_width="55dp" android:layout_height="wrap_content" android:gravity="end" android:text="70 ms" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="@font/gf_bold"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Duration Tap:" android:textColor="#F0F0F0" android:textSize="15sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical">
        <com.ancore.GamingSeekBar android:id="@+id/seek_macro_duration" android:layout_width="0dp" android:layout_height="31dp" android:layout_weight="1"/>
        <TextView android:id="@+id/val_macro_duration" android:layout_width="55dp" android:layout_height="wrap_content" android:gravity="end" android:text="70 ms" android:textColor="#FFFFFF" android:textSize="14sp" android:fontFamily="@font/gf_bold"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hold Trigger = repeat • release Trigger = stop" android:textColor="#20E6AA" android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>
